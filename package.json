{
  "name": "env-autocomplete-with-comments",
  "displayName": "ENV Autocomplete with Comments",
  "description": "Auto-completes common .env keys with descriptive comments and grouping.",
  "version": "1.0.5",
  "publisher": "choihunchul",
  "icon": "icon.png",
  "license": "MIT",
  "author": {
    "name": "choihunchul"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/choihunchul/env-autocomplete.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:properties",
    "onLanguage:dotenv"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "envAutocomplete.addKeyToDictionary",
        "title": "%command.addKeyToDictionary.title%"
      },
      {
        "command": "envAutocomplete.createOrSyncExample",
        "title": "%command.createOrSyncExample.title%",
        "icon": "$(sync)"
      },
      {
        "command": "envAutocomplete.createOrSyncEnv",
        "title": "%command.createOrSyncEnv.title%",
        "icon": "$(sync)"
      },
      {
        "command": "envAutocomplete.compareKeys",
        "title": "%command.compareKeys.title%",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "envAutocomplete.createOrSyncExample",
          "when": "resourceFilename == .env",
          "group": "env-sync@1"
        },
        {
          "command": "envAutocomplete.createOrSyncEnv",
          "when": "resourceFilename == .env.example",
          "group": "env-sync@1"
        },
        {
          "command": "envAutocomplete.compareKeys",
          "when": "resourceFilename =~ /^\\.env(\\..+)?$/",
          "group": "env-sync@2"
        }
      ],
      "editor/title": [
        {
          "command": "envAutocomplete.createOrSyncExample",
          "when": "resourceFilename == .env",
          "group": "navigation@1"
        },
        {
          "command": "envAutocomplete.createOrSyncEnv",
          "when": "resourceFilename == .env.example",
          "group": "navigation@1"
        },
        {
          "command": "envAutocomplete.compareKeys",
          "when": "resourceFilename =~ /^\\.env(\\..+)?$/",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "envAutocomplete.createOrSyncExample",
          "when": "resourceFilename == .env",
          "group": "env-sync@1"
        },
        {
          "command": "envAutocomplete.createOrSyncEnv",
          "when": "resourceFilename == .env.example",
          "group": "env-sync@1"
        },
        {
          "command": "envAutocomplete.compareKeys",
          "when": "resourceFilename =~ /^\\.env(\\..+)?$/",
          "group": "env-sync@2"
        }
      ]
    },
    "languages": [
      {
        "id": "dotenv",
        "extensions": [
          ".env",
          ".env.example",
          ".env.local",
          ".env.development",
          ".env.production",
          ".env.test"
        ]
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "envAutocomplete.enableBuiltInKeys": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableBuiltInKeys.description%"
        },
        "envAutocomplete.customKeys": {
          "type": "object",
          "default": {},
          "description": "%config.customKeys.description%"
        },
        "envAutocomplete.scanProjectForKeys": {
          "type": "boolean",
          "default": true,
          "description": "%config.scanProjectForKeys.description%"
        },
        "envAutocomplete.maskValues": {
          "type": "boolean",
          "default": true,
          "description": "%config.maskValues.description%"
        },
        "envAutocomplete.highlightUnknownKeys": {
          "type": "boolean",
          "default": true,
          "description": "%config.highlightUnknownKeys.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest --passWithNoTests",
    "package": "npx @vscode/vsce package",
    "publish:marketplace": "source .env && npx @vscode/vsce publish -p $VSCE_PAT",
    "publish:openvsx": "source .env && npx ovsx publish -p $OVSX_PAT"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
